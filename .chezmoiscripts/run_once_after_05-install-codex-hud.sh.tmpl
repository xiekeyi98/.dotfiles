#!/bin/bash
{{ if lookPath "codex" -}}
set -e

DEST="$HOME/.local/share/codex-hud"
REPO="https://github.com/fwyc0573/codex-hud.git"

echo "==> Installing Codex HUD..."

if ! command -v git >/dev/null 2>&1; then
    echo "  [warn] git not found; skipping Codex HUD install"
    exit 0
fi

if ! command -v node >/dev/null 2>&1; then
    echo "  [warn] node not found; skipping Codex HUD install"
    exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "  [warn] npm not found; skipping Codex HUD install"
    exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "  [warn] tmux not found; Codex HUD wrapper will not run until tmux is installed"
fi

if [ ! -d "$DEST/.git" ]; then
    mkdir -p "$(dirname "$DEST")"
    git clone --depth 1 "$REPO" "$DEST"
else
    echo "  [ok] Codex HUD checkout already exists"
fi

npm --prefix "$DEST" install
npm --prefix "$DEST" run build

chmod +x "$DEST/bin/codex-hud" \
    "$DEST/bin/codex-hud-install" \
    "$DEST/bin/codex-hud-sync" \
    "$DEST/bin/codex-hud-upgrade" \
    "$DEST/bin/codex-hud-uninstall"

if [ -f "$DEST/bin/codex-hud-resize" ]; then
    chmod +x "$DEST/bin/codex-hud-resize"
fi

echo "  [ok] Codex HUD installed"
{{ end -}}
